PROJECT_NAME=crm-whatsapp-automatizado
TZ=America/Santiago

# Imagenes Docker
N8N_IMAGE=docker.n8n.io/n8nio/n8n:1.123.29
POSTGRES_IMAGE=postgres:16.13-alpine
REDIS_IMAGE=redis:7.4-alpine
EVOLUTION_API_IMAGE=evoapicloud/evolution-api:v2.3.7

# n8n
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=__GENERAR_VALOR_SEGURO__
N8N_SECURE_COOKIE=false
N8N_RUNNERS_ENABLED=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_GIT_NODE_DISABLE_BARE_REPOS=true
NODE_FUNCTION_ALLOW_BUILTIN=crypto,fs,path
N8N_RESTRICT_FILE_ACCESS_TO=/data/media

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
POSTGRES_DB=crm_whatsapp
APP_POSTGRES_DB=crm_whatsapp_app
EVOLUTION_POSTGRES_DB=evolution_api
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
DB_POSTGRESDB_SCHEMA=public
# Required allowlist for scripts/ops/reset-controlled-test-session.sh.
CONTROLLED_TEST_PHONE_NUMBER=

# Evolution API
EVOLUTION_API_PORT=8080
EVOLUTION_SERVER_TYPE=http
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_API_BASE_URL=http://evolution-api:8080
EVOLUTION_API_KEY=__GENERAR_VALOR_SEGURO__
EVOLUTION_DEFAULT_INSTANCE=wahormiglass
EVOLUTION_DEFAULT_INSTANCE_TOKEN=
EVOLUTION_WEBHOOK_SECRET=__GENERAR_VALOR_SEGURO__
# Webhook productivo interno de Docker para "WA - Inbound Entry".
# El token se agrega automaticamente desde EVOLUTION_WEBHOOK_SECRET.
EVOLUTION_WEBHOOK_URL=http://n8n:5678/webhook/6TgrfXCUUixpJOWh/evolutionwebhook/wa-inbound-entry
EVOLUTION_WEBHOOK_EVENTS=MESSAGES_UPSERT
INBOUND_PROCESSING_STALE_SECONDS=600
INBOUND_RECOVERY_BATCH_SIZE=20
INBOUND_MAX_PROCESSING_ATTEMPTS=5
OUTBOUND_CLAIM_STALE_SECONDS=300
EVOLUTION_EXPOSE_INSTANCES=true
EVOLUTION_LANGUAGE=en
EVOLUTION_DEL_INSTANCE=false
EVOLUTION_DB_CLIENT_NAME=evolution_exchange
EVOLUTION_SAVE_INSTANCE_DATA=true
EVOLUTION_SAVE_NEW_MESSAGES=true
EVOLUTION_SAVE_MESSAGE_UPDATE=true
EVOLUTION_SAVE_CONTACTS=true
EVOLUTION_SAVE_CHATS=true
EVOLUTION_SAVE_LABELS=false
EVOLUTION_SAVE_HISTORIC=true
EVOLUTION_REDIS_ENABLED=true
EVOLUTION_SAVE_INSTANCES_IN_REDIS=true
EVOLUTION_REDIS_PREFIX=evolution
EVOLUTION_TELEMETRY=false

# Durable inbound media download through Evolution API (never external_url)
MEDIA_STORAGE_ROOT=/data/media
MEDIA_DOWNLOAD_BATCH_SIZE=20
MEDIA_DOWNLOAD_STALE_SECONDS=900
MEDIA_DOWNLOAD_TIMEOUT_MS=30000
MEDIA_MAX_BYTES_IMAGE=26214400
MEDIA_MAX_BYTES_DOCUMENT=26214400
MEDIA_MAX_BYTES_AUDIO=26214400
MEDIA_MAX_BYTES_VIDEO=52428800

# ClickUp
CLICKUP_API_TOKEN=__PENDIENTE__
CLICKUP_LEADS_LIST_ID=__PENDIENTE__
CLICKUP_HANDOFF_LIST_ID=__PENDIENTE__
CLICKUP_TEAM_ID=__PENDIENTE__
# Returned by ClickUp when the webhook is registered. Never commit the real value.
CLICKUP_WEBHOOK_SECRET=__PENDIENTE__
# Comma-separated ClickUp status labels matched case-insensitively.
CLICKUP_STATUS_ACKNOWLEDGED="in progress,en progreso,en curso"
CLICKUP_STATUS_RESOLVED="complete,completed,closed,done,cerrado,resuelto"
CLICKUP_CF_WHATSAPP_NAME_ID=__PENDIENTE__
CLICKUP_CF_PHONE_ID=__PENDIENTE__
CLICKUP_CF_SERVICE_ID=__PENDIENTE__
CLICKUP_CF_CITY_ID=__PENDIENTE__
CLICKUP_CF_REQUIREMENT_ID=__PENDIENTE__
CLICKUP_CF_CHANNEL_ID=__PENDIENTE__
CLICKUP_CF_CHANNEL_OPTION_WHATSAPP_ID=__PENDIENTE__
CLICKUP_CF_INTERNAL_LEAD_ID=__PENDIENTE__
CLICKUP_CF_SOURCE_NUMBER_ID=__PENDIENTE__
# JSON area -> ClickUp user id(s), e.g. {"sales":[123],"claims":[456]}
HANDOFF_CLICKUP_ASSIGNEES_JSON=__PENDIENTE__
HANDOFF_NOTIFICATION_BATCH_SIZE=20
HANDOFF_NOTIFICATION_STALE_SECONDS=900
FOLLOW_UP_BATCH_SIZE=50
FOLLOW_UP_WINDOW_START=09:00
FOLLOW_UP_WINDOW_END=20:00
FOLLOW_UP_CLAIM_STALE_SECONDS=900
FOLLOW_UP_FIRST_DELAY_HOURS=24

# Notificaciones internas
INTERNAL_NOTIFICATION_CHANNEL=clickup

# Reintentos HTTP externos
EXTERNAL_HTTP_MAX_ATTEMPTS=4
EXTERNAL_HTTP_RETRY_BASE_MS=1000
EXTERNAL_HTTP_RETRY_MAX_MS=10000

# IA Hormi Atención (API directa definitiva)
# AI_PROVIDER es una etiqueta operativa; la compatibilidad real la define
# AI_DIRECT_API_BASE_URL + AI_DIRECT_API_PATH + AI_DIRECT_API_MODEL.
# Modelo canónico estable: gemini-3.1-flash-lite
# Candidato de escalamiento manual: gemini-3.5-flash
# Evitar modelos preview/latest como valor por defecto.
AI_LEAD_ASSISTANT_ENABLED=true
AI_PROVIDER=google
AI_API_KEY_REQUIRED=true
# La llave real solo debe existir en .env local.
AI_DIRECT_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_DIRECT_API_PATH=/chat/completions
AI_DIRECT_API_KEY=__PENDIENTE__
AI_DIRECT_API_MODEL=gemini-3.1-flash-lite
AI_DIRECT_API_TIMEOUT_MS=120000
AI_DIRECT_API_TEMPERATURE=0.1
AI_DIRECT_API_MAX_TOKENS=2000
AI_DIRECT_API_MAX_ATTEMPTS=2
AI_DIRECT_API_RETRY_BASE_MS=2000
AI_DIRECT_API_RETRY_MAX_MS=30000
AI_DIRECT_API_RATE_LIMIT_COOLDOWN_MS=60000
AI_MODEL_C_ENABLED=true
AI_HEALTHY_MIN_CONFIDENCE=0.45
AI_FIELD_ACCEPT_MIN_CONFIDENCE=0.55
AI_REPLY_TEXT_MIN_CONFIDENCE=0.50
AI_OBJECTION_MIN_CONFIDENCE=0.50
AI_B2B_MIN_CONFIDENCE=0.55
AI_PRD_VALIDATION_ENABLED=true
# Fail-closed rollout: shadow/enforce only applies to CONTROLLED_TEST_PHONE_NUMBER.
AI_PRD_CONVERSATION_MODE=legacy
