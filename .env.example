PROJECT_NAME=crm-whatsapp-automatizado
TZ=America/Santiago

# Imagenes Docker
N8N_IMAGE=docker.n8n.io/n8nio/n8n:1.123.29
POSTGRES_IMAGE=postgres:16.13-alpine
REDIS_IMAGE=redis:7.4-alpine
EVOLUTION_API_IMAGE=evoapicloud/evolution-api:v2.3.7

# n8n
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=__GENERAR_VALOR_SEGURO__
N8N_SECURE_COOKIE=false
N8N_RUNNERS_ENABLED=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_GIT_NODE_DISABLE_BARE_REPOS=true

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
POSTGRES_DB=crm_whatsapp
APP_POSTGRES_DB=crm_whatsapp_app
EVOLUTION_POSTGRES_DB=evolution_api
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
DB_POSTGRESDB_SCHEMA=public

# Evolution API
EVOLUTION_API_PORT=8080
EVOLUTION_SERVER_TYPE=http
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_API_BASE_URL=http://evolution-api:8080
EVOLUTION_API_KEY=__GENERAR_VALOR_SEGURO__
EVOLUTION_DEFAULT_INSTANCE=principal
EVOLUTION_DEFAULT_INSTANCE_TOKEN=
EVOLUTION_WEBHOOK_SECRET=__GENERAR_VALOR_SEGURO__
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:5678/webhook/mXz1XhLO0cd9PME6/evolutionwebhook/wa-inbound-entry?token=__MISMO_VALOR_DE_EVOLUTION_WEBHOOK_SECRET__
EVOLUTION_WEBHOOK_EVENTS=MESSAGES_UPSERT
EVOLUTION_EXPOSE_INSTANCES=true
EVOLUTION_LANGUAGE=en
EVOLUTION_DEL_INSTANCE=false
EVOLUTION_DB_CLIENT_NAME=evolution_exchange
EVOLUTION_SAVE_INSTANCE_DATA=true
EVOLUTION_SAVE_NEW_MESSAGES=true
EVOLUTION_SAVE_MESSAGE_UPDATE=true
EVOLUTION_SAVE_CONTACTS=true
EVOLUTION_SAVE_CHATS=true
EVOLUTION_SAVE_LABELS=false
EVOLUTION_SAVE_HISTORIC=true
EVOLUTION_REDIS_ENABLED=true
EVOLUTION_SAVE_INSTANCES_IN_REDIS=true
EVOLUTION_REDIS_PREFIX=evolution
EVOLUTION_TELEMETRY=false

# ClickUp
CLICKUP_API_TOKEN=__PENDIENTE__
CLICKUP_LIST_ID=__PENDIENTE__
CLICKUP_TEAM_ID=__PENDIENTE__
CLICKUP_CF_WHATSAPP_NAME_ID=__PENDIENTE__
CLICKUP_CF_PHONE_ID=__PENDIENTE__
CLICKUP_CF_SERVICE_ID=__PENDIENTE__
CLICKUP_CF_CITY_ID=__PENDIENTE__
CLICKUP_CF_REQUIREMENT_ID=__PENDIENTE__
CLICKUP_CF_CHANNEL_ID=__PENDIENTE__
CLICKUP_CF_CHANNEL_OPTION_WHATSAPP_ID=__PENDIENTE__
CLICKUP_CF_INTERNAL_LEAD_ID=__PENDIENTE__
CLICKUP_CF_SOURCE_NUMBER_ID=__PENDIENTE__

# Notificaciones internas
INTERNAL_NOTIFICATION_CHANNEL=clickup

# Reintentos HTTP externos
EXTERNAL_HTTP_MAX_ATTEMPTS=4
EXTERNAL_HTTP_RETRY_BASE_MS=1000
EXTERNAL_HTTP_RETRY_MAX_MS=10000

# AI controlada
AI_LEAD_ASSISTANT_ENABLED=false
AI_PROVIDER=nvidia
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_MODE=chat_completions
AI_API_KEY=__PENDIENTE__
AI_API_KEY_REQUIRED=true
AI_MODEL=minimaxai/minimax-m2.5
