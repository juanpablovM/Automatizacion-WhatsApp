      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE inbound_events\nSET processing_status='processed', processing_phase='completed', processed_at=NOW(),\n    processing_token=NULL, failure_reason=NULL, updated_at=NOW()\nWHERE id=NULLIF($1::text,'')::bigint\n  AND processing_status='processing' AND processing_token=NULLIF($2::text,'')\n  AND downstream_payload <> '{}'::jsonb\nRETURNING id AS completed_inbound_event_id, TRUE AS downstream_completed;",
        "options": {
