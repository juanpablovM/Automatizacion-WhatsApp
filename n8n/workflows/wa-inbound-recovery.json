        "jsCode": "return items.map((item) => {\n  const durable = item.json.downstream_payload && typeof item.json.downstream_payload === 'object'\n    ? item.json.downstream_payload : {};\n  const hasDurableResult = Object.keys(durable).length > 0;\n  const base = hasDurableResult ? durable : (item.json.normalized_payload || {});\n  const normalizedBase = Object.fromEntries(Object.entries(base).map(([key, value]) => {\n    const normalized = typeof value === 'string' && ['null', 'undefined'].includes(value.trim().toLowerCase()) ? null : value;\n    return [key, normalized];\n  }));\n  return { json: {\n    ...normalizedBase,\n    source_number_id: item.json.source_number_id,\n    inbound_event_id: item.json.inbound_event_id,\n    processing_token: item.json.processing_token,\n    should_process: true,\n    recovered_event: true,\n    resume_downstream: hasDurableResult,\n  } };\n});"
