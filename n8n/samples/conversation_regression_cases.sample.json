{
  "suite": "post_ai_conversation_regression",
  "version": 3,
  "required_evidence": [
    "conversation_id",
    "lead_id",
    "clickup_task_id",
    "vendedor",
    "auditorias"
  ],
  "lead_creation_gate": [
    "servicio",
    "ciudad",
    "requerimiento",
    "confirmacion"
  ],
  "cases": [
    {
      "id": "CP-01",
      "title": "Saludo simple",
      "ai_mode": "both",
      "input": {
        "messages": [
          "Hola"
        ],
        "processable": true
      },
      "expected": {
        "conversation_created": true,
        "lead_created": false,
        "clickup_task_created": false,
        "confirmed_by_user": false,
        "next_step_any": [
          "city",
          "service"
        ],
        "audit_required": true
      }
    },
    {
      "id": "CP-02",
      "title": "Mensaje completo desde el inicio",
      "ai_mode": "both",
      "input": {
        "messages": [
          "Hola, necesito comprar baldosas en Santiago para renovar un bano"
        ],
        "processable": true
      },
      "expected": {
        "conversation_created": true,
        "lead_created": false,
        "clickup_task_created": false,
        "confirmed_by_user": false,
        "fields_detected": [
          "servicio",
          "ciudad",
          "requerimiento"
